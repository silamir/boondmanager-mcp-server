{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run docs:tools)",
      "Bash(npm run docs:tools:check)",
      "Bash(npm run plugin:manifest)",
      "Bash(npm run plugin:manifest:check)",
      "Bash(npx vitest run *)"
    ],
    "ask": ["Bash(git push *)", "Bash(git tag *)", "Bash(npm publish *)"],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.production)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in */src/*.ts|*/src/*.js|*/src/*.json) cd \"$CLAUDE_PROJECT_DIR\" && npx --no-install prettier --write --log-level warn \"$f\" ;; esac; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-typecheck.sh\"" }]
      }
    ]
  }
}
